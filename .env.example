# WhatsApp only: default is local simulation. Discord/Telegram send real replies.
DRY_RUN=true
# For local dry-run only, use arbitrary dummy values; replace for Meta setup.
VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Your own test recipient(s), international digits only, no + or spaces.
TEST_ALLOWED_SENDERS=
# Required only for live mode. Never paste secrets into chat or screenshots.
WHATSAPP_ACCESS_TOKEN=
# Set the supported version shown by Meta API Setup, for example vXX.0.
GRAPH_API_VERSION=
DATABASE_PATH=data/messages.db

# Telegram and Discord runners send real messages when explicitly started.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=
MOCK_DATABASE_PATH=data/mock.db
TELEGRAM_DATABASE_PATH=data/telegram.db
DISCORD_DATABASE_PATH=data/discord.db
# Optional: users allowed to send "status" (Telegram/Discord/mock). Format channel:user_id, comma-separated.
# Supports telegram/discord/mock only (WhatsApp is not supported). The mock user ID is always "local".
# Invalid entries stop startup. If the DB is broken, admin "status" still replies with "DB接続: 接続失敗" (no dedup/state update).
ADMIN_USERS=
